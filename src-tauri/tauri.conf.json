{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vertex FM Engine",
  "version": "0.1.0",
  "identifier": "com.vertexproject.fmengine",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vertex FM Engine",
        "width": 1920,
        "height": 1200,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "backgroundColor": "#070b10"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "FileMaker XML Clipboard development environment",
    "longDescription": "Vertex FM Engine accelerates FileMaker development with XML Clipboard editing, validation, history, and reusable libraries."
  }
}
